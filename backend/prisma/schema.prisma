generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  createdAt DateTime @default(now())

  payees         Payee[]
  transactions   Transaction[]
  messages       Message[]
  ledgerEntries  LedgerEntry[]
  behaviours     UserBehaviour[]
  assessments    Assessment[]

  @@index([createdAt])
}

model Payee {
  id          String            @id @default(cuid())
  userId      String
  name        String
  upiId       String?
  relationship String
  isVerified  Boolean           @default(false)
  createdAt   DateTime          @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([userId])
  @@index([upiId])
}

model Transaction {
  id        String        @id @default(cuid())
  userId    String
  payeeId   String
  amount    Float
  currency  String        @default("INR")
  timestamp DateTime      @default(now())
  status    String        @default("PENDING")
  description String?

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  payee         Payee         @relation(fields: [payeeId], references: [id], onDelete: Cascade)

  ledgerEntries LedgerEntry[]
  assessments   Assessment[]

  @@index([userId])
  @@index([payeeId])
  @@index([timestamp])
  @@index([status])
}

model Message {
  id                String          @id @default(cuid())
  userId            String
  channel           String
  senderName        String?
  senderIdentifier  String?
  content           String
  timestamp         DateTime        @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([timestamp])
}

model LedgerEntry {
  id             String           @id @default(cuid())
  userId         String
  transactionId  String?
  type           String
  amount         Float
  currency       String           @default("INR")
  timestamp      DateTime         @default(now())
  counterpartyId String?
  description    String?

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  transaction Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([transactionId])
  @@index([timestamp])
  @@index([type])
}

model UserBehaviour {
  id                       String   @id @default(cuid())
  userId                   String
  recordedAt               DateTime @default(now())

  averageTransactionAmount Float
  averageDailyTransactionCount Float
  typicalPaymentHour       Int?
  typicalPayeeCount        Int
  recentPaymentCount       Int

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([recordedAt])
}

model Assessment {
  id              String            @id @default(cuid())
  paymentId       String
  userId          String

  timestamp       DateTime          @default(now())

  riskScore       Int
  riskBand        String

  signals         String
  mitigators      String
  explanation     String

  engineVersion   String

  userDecision    String?
  outcome         String?

  processingTimeMs Int

  payment Transaction @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  decision UserDecision?

  @@index([paymentId])
  @@index([userId])
  @@index([timestamp])
  @@index([riskBand])
}

model UserDecision {
  id           String           @id @default(cuid())
  assessmentId String           @unique

  decision     String
  decidedAt    DateTime         @default(now())

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@index([decidedAt])
}
